# Grader frontend — environment template.
# Copy to .env.local for dev, or supply via container env in production.
# Never commit the resulting file.
#
# All vars are validated at runtime by src/utils/env.ts (@t3-oss/env-nextjs).
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Public URL browsers use to reach the frontend.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# ─── Keycloak (SSO) ───────────────────────────────────────────────────────────
# Base URL of the Keycloak server (no trailing slash).
KEYCLOAK_BASE_URL=http://localhost:9080
KEYCLOAK_REALM=university-grader
KEYCLOAK_CLIENT_ID=grader-frontend
# Must match GRADER_FRONTEND_CLIENT_SECRET in the backend .env.
KEYCLOAK_CLIENT_SECRET=change-me

# ─── Backend API ──────────────────────────────────────────────────────────────
# Public URL used by browser code (NEXT_PUBLIC_* is exposed to the client bundle).
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Optional ─────────────────────────────────────────────────────────────────
# Server-side backend URL when the public URL is unreachable from inside the
# container (e.g. Docker: http://backend:8080). Used by server components only.
# API_INTERNAL_URL=http://backend:8080
#
# Skip Zod validation of env vars during `next build` (needed when secrets are
# only available at runtime, not build time). Set to 1 only in build pipelines.
# SKIP_ENV_VALIDATION=1
